rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 모임: 링크를 아는 사람은 읽을 수 있고, 기간(months)과 정원(capacity)만 바꿀 수 있어요
    match /rooms/{roomId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['title', 'months', 'capacity', 'createdAt'])
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 40
                    && validMonths(request.resource.data.months)
                    && validCapacity(request.resource.data);
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['months', 'capacity'])
                    && validMonths(request.resource.data.months)
                    && validCapacity(request.resource.data);
      allow delete: if false;

      // 참여자: 이름, 안 되는 날짜 목록, 다 표시했는지 여부
      match /members/{memberId} {
        allow read: if true;
        allow create, update: if request.resource.data.keys().hasOnly(['name', 'dates', 'done', 'updatedAt'])
                              && request.resource.data.name is string
                              && request.resource.data.name.size() > 0
                              && request.resource.data.name.size() <= 20
                              && request.resource.data.dates is list
                              && request.resource.data.dates.size() <= 400
                              && request.resource.data.done is bool;
        allow delete: if true;   // 나가기, 방장이 빼기
      }
    }

    // 정원은 2~30명. 예전에 만든 모임은 정원이 없을 수 있어요
    function validCapacity(d) {
      return !('capacity' in d) || (d.capacity is int && d.capacity >= 2 && d.capacity <= 30);
    }

    function validMonths(m) {
      return m is list && m.size() >= 1 && m.size() <= 12;
    }
  }
}

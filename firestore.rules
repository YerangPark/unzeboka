rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 모임: 링크를 아는 사람은 읽을 수 있고, 기간(months)과 정원(capacity)만 바꿀 수 있어요
    // expireAt: 만든 날부터 30일 뒤. GitHub Actions(scripts/cleanup.mjs)가 지난 모임을 지워요
    // hostHash: 방장 비밀 열쇠의 SHA-256(16진수). 열쇠는 방장 브라우저에만 있어요
    match /rooms/{roomId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['title', 'months', 'capacity', 'slots', 'createdAt', 'expireAt', 'hostHash'])
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 40
                    && validMonths(request.resource.data.months)
                    && validCapacity(request.resource.data)
                    && (!('slots' in request.resource.data) || request.resource.data.slots is bool)
                    && (!('expireAt' in request.resource.data) || request.resource.data.expireAt is timestamp)
                    && (!('hostHash' in request.resource.data) || (request.resource.data.hostHash is string && request.resource.data.hostHash.size() == 64));
      // 1) 기간·정원 바꾸기
      // 2) 방장 삭제 표시: 보낸 열쇠의 해시가 저장된 hostHash와 같을 때만 deleted를 켤 수 있어요
      allow update: if (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['months', 'capacity'])
                        && validMonths(request.resource.data.months)
                        && validCapacity(request.resource.data))
                    || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'deleteKey'])
                        && request.resource.data.deleted == true
                        && 'hostHash' in resource.data
                        && request.resource.data.deleteKey is string
                        && hashing.sha256(request.resource.data.deleteKey).toHexString().lower() == resource.data.hostHash);
      // 방장이 삭제 표시를 한 모임만 지울 수 있어요
      allow delete: if resource.data.get('deleted', false) == true;

      // 참여자: 이름, 안 되는 날짜 목록('2026-12-05' 또는 점심·저녁 모임은 '2026-12-05:lunch'), 다 표시했는지 여부
      match /members/{memberId} {
        allow read: if true;
        allow create, update: if request.resource.data.keys().hasOnly(['name', 'dates', 'done', 'color', 'notes', 'updatedAt', 'expireAt'])
                              && request.resource.data.name is string
                              && request.resource.data.name.size() > 0
                              && request.resource.data.name.size() <= 20
                              && request.resource.data.dates is list
                              && request.resource.data.dates.size() <= 800
                              && request.resource.data.done is bool
                              && (!('expireAt' in request.resource.data) || request.resource.data.expireAt is timestamp)
                              && (!('notes' in request.resource.data) || (request.resource.data.notes is map && request.resource.data.notes.size() <= 200))
                              && (!('color' in request.resource.data) || (request.resource.data.color is int && request.resource.data.color >= 0 && request.resource.data.color < 16));
        allow delete: if true;   // 나가기, 방장이 빼기
      }
    }

    // 정원은 2~30명. 예전에 만든 모임은 정원이 없을 수 있어요
    function validCapacity(d) {
      return !('capacity' in d) || (d.capacity is int && d.capacity >= 2 && d.capacity <= 30);
    }

    function validMonths(m) {
      return m is list && m.size() >= 1 && m.size() <= 12;
    }
  }
}
